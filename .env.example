# Application
PORT=5000
NODE_ENV=development
APP_NAME=HDWSS

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/hdwss?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Frontend origins (comma-separated for multi-origin CORS)
FRONTEND_URL=http://localhost:3000

# Upstash Redis (REST API — no TCP connection required)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
CACHE_TTL=60

# Cloudinary (media storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# OpenWeatherMap
OPENWEATHER_API_KEY=your_openweathermap_key
OPENWEATHER_DEFAULT_CITY=Nairobi
OPENWEATHER_DEFAULT_COUNTRY=KE

# ExchangeRate API (https://open.er-api.com — free tier)
EXCHANGERATE_API_KEY=your_exchangerate_api_key
FOREX_BASE_CURRENCY=USD
FOREX_TARGET_CURRENCIES=KES,EUR,GBP,AED,TZS,UGX

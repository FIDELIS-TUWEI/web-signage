# Server
PORT=5000
NODE_ENV=development
APP_NAME=HDWSS

# MongoDB (required)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/web-signage?retryWrites=true&w=majority

# JWT (required)
JWT_SECRET=change-me-at-least-32-random-characters
JWT_REFRESH_SECRET=change-me-different-from-jwt-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS — comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:3000

# Upstash Redis (optional — falls back to in-memory cache)
UPSTASH_REDIS_REST_URL=https://<instance>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<token>
CACHE_TTL=60

# Cloudinary
CLOUDINARY_CLOUD_NAME=<cloud_name>
CLOUDINARY_API_KEY=<api_key>
CLOUDINARY_API_SECRET=<api_secret>

# OpenWeatherMap
OPENWEATHER_API_KEY=<api_key>
OPENWEATHER_DEFAULT_CITY=Nairobi
OPENWEATHER_DEFAULT_COUNTRY=KE

# ExchangeRate API (open.er-api.com)
EXCHANGERATE_API_KEY=<api_key>
FOREX_BASE_CURRENCY=USD
FOREX_TARGET_CURRENCIES=KES,EUR,GBP,AED
